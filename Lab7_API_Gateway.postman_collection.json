{
  "info": {
    "name": "Lab 7 — API Gateway & Cloud Deployment",
    "description": "CampusConnect API Gateway tests. All requests go through the gateway (port 3000) — services are not directly accessible.\n\nVariables:\n- {{gateway_url}}: Local = http://localhost:3000, Cloud = your public gateway URL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "cloud_gateway_url",
      "value": "https://YOUR-GATEWAY.onrender.com",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Gateway Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": ["{{gateway_url}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway is UP', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "    pm.expect(json.service).to.eql('api-gateway');",
                  "    pm.expect(json.registeredServices).to.be.an('array').with.lengthOf(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. User Service (via Gateway)",
      "item": [
        {
          "name": "POST /users — Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Harsh Patel\",\n  \"email\": \"harsh.lab7@campusconnect.edu\",\n  \"role\": \"student\",\n  \"department\": \"Computer Science\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/users",
              "host": ["{{gateway_url}}"],
              "path": ["users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created via gateway', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.name).to.eql('Harsh Patel');",
                  "    pm.collectionVariables.set('user_id', json._id || json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /users — List All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/users",
              "host": ["{{gateway_url}}"],
              "path": ["users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Users listed via gateway', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /users/:id — Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/users/{{user_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User fetched via gateway', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().name).to.eql('Harsh Patel');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT /users/:id — Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department\": \"Information Technology\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/users/{{user_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User updated via gateway', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().department).to.eql('Information Technology');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /users/:id — Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/users/{{user_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User deleted via gateway', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
