    {
      "name": "5. Error Handling — Unreachable Service (502/503)",
      "item": [
        {
          "name": "GET /users (after stopping user-service) — Expect 502/503",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/users",
              "host": ["{{gateway_url}}"],
              "path": ["users"]
            },
            "description": "Stop user-service (docker compose stop user-service) BEFORE running this.\nExpected: 502 or 503 with a clean JSON error, NOT a timeout or crash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway returns 502 or 503 for unreachable service', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([502, 503]);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('error');",
                  "    pm.expect(json).to.have.property('targetService');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Gateway 404 — Unknown Route",
      "item": [
        {
          "name": "GET /unknown-route — Expect 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/nonexistent",
              "host": ["{{gateway_url}}"],
              "path": ["nonexistent"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway returns 404 for unknown route', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().gateway).to.eql('api-gateway');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
