# ================================================================
# Lab 7 — Environment Configuration Template
# ================================================================

# API Gateway
GATEWAY_PORT=3000

# Service Registry — Configuration-Based Service Discovery
# The gateway reads these at startup to build its routing table.
# Change a service's location here — no code changes needed.
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Service Ports
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003

# Internal MongoDB URIs (Database-per-Service)
USER_MONGO_URI=mongodb://user-db:27017/user_service_db
PRODUCT_MONGO_URI=mongodb://product-db:27017/product_service_db
ORDER_MONGO_URI=mongodb://order-db:27017/order_service_db

# ================================================================
# Cloud Deployment — replace above with cloud values:
# ================================================================
# USER_SERVICE_URL=https://your-user-service.onrender.com
# PRODUCT_SERVICE_URL=https://your-product-service.onrender.com
# ORDER_SERVICE_URL=https://your-order-service.onrender.com
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/<db>?retryWrites=true&w=majority
